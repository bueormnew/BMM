# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Windows batch scripts
*.bat text eol=crlf

# Binary files
*.pt binary
*.bin binary
*.safetensors binary
*.gguf binary
*.bueorm binary
*.png binary
*.jpg binary
*.jpeg binary
